# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Capacitor
/android/app/build

# Old Firebase config download (not used any more)
google-services.json

# Android Studio editor settings
/android/.idea/
# Supabase CLI state (`npx supabase link`)
/supabase/.temp/
# Copied from pdfjs-dist by `npm install` (postinstall)
/public/pdf.worker.min.mjs
# Spotify App Remote SDK (download it yourself; see README)
/native/android-libs/*.aar

# Play upload key (never commit; see docs/Stack_Launch_Guide.pdf, stage 4)
/android/keystore.properties
*.jks
*.keystore
