# Copy to .env.local for local development. Never put real values in this file: it's in git.

# Public (shown on the page)
NEXT_PUBLIC_SITE_URL=https://stackforge.in
NEXT_PUBLIC_SUPPORT_EMAIL=hello@stackforge.in

# Server only. Never prefix these with NEXT_PUBLIC_.
# Firebase → Project settings → Service accounts → Generate new private key.
# Use a dedicated service account with only the "Cloud Datastore User" role.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Any long random string, e.g. `openssl rand -hex 32`. Changing it resets the rate limiter
# and changes future document ids, so set it once.
WAITLIST_SALT=
