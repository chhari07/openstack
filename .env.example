# Copy this file to .env.local and fill in what you use. Everything is optional:
# Stack works without any of it. Never put real keys in this file (it's in git).
# After changing .env.local: restart `npm run dev`, and run ./build-apk.sh again for the app.

# ---- Spotify ----
# Spotify app Client ID (developer.spotify.com/dashboard).
# Redirect URI to register: http://127.0.0.1:3000/music/callback
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# ---- Accounts and sync (Supabase) ----
# See supabase/README.md.
# Supabase dashboard → Project settings → API: the project URL and the
# publishable key (sb_publishable_...). Both are meant to be public (they ship
# inside the app). An older project's "anon" key works too, here or as
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud → Credentials → the "Web application" OAuth client ID: Android's
# account picker. The same ID goes into Supabase → Authentication → Providers → Google.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---- Stack AI ----
# Stack AI runs in the "ai" Supabase function (supabase/functions/ai). Its
# address: https://<project>.supabase.co/functions/v1/ai. Leave empty to hide AI.
NEXT_PUBLIC_AI_URL=
# Name shown in the app's "ask first" sheet, e.g. OpenAI or Claude.
NEXT_PUBLIC_AI_ENGINE=

# The AI keys and settings are NOT read from this file: they are the function's
# secrets, set in Supabase (dashboard → Edge Functions → Secrets, or
# `npx supabase secrets set NAME=value`). Never put a key in a NEXT_PUBLIC_ variable.
#   AI_PROVIDER       "openai" or "anthropic" (Claude)
#   OPENAI_API_KEY    platform.openai.com → API keys
#   OPENAI_MODEL      default gpt-5.5. Per feature: OPENAI_MODEL_SUMMARY,
#                     OPENAI_MODEL_TIDY, OPENAI_MODEL_ASK, OPENAI_MODEL_PDF (e.g. gpt-5.4-mini)
#   ANTHROPIC_API_KEY platform.claude.com
#   AI_MODEL          default claude-opus-5-5. Per feature: AI_MODEL_SUMMARY, AI_MODEL_TIDY,
#                     AI_MODEL_ASK, AI_MODEL_PDF (e.g. claude-sonnet-5-5 or claude-haiku-4-5).
#                     For the public launch, claude-haiku-4-5 keeps the cost per user low
#                     (see docs/StackForge_Stack_Plan.pdf, page 8).
#   AI_DAILY_LIMIT    requests per person per day (default 50; 20 is a safe start for a launch)

# ---- Public pages ----
# Shown on /privacy and /delete-account (Google Play links to both).
NEXT_PUBLIC_SUPPORT_EMAIL=
