# Copy this file to .env.local and fill in what you use. Everything is optional:
# Stack works without any of it. Never put real keys in this file (it's in git).
# After changing .env.local: restart `npm run dev`, and run ./build-apk.sh again for the app.

# ---- Spotify ----
# Spotify app Client ID (developer.spotify.com/dashboard).
# Redirect URI to register: http://127.0.0.1:3000/music/callback
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# ---- Accounts and sync (Firebase) ----
# See firebase/README.md.
# Firebase console → Project settings → Your apps → Web app → config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Only with Cloud Storage (Blaze plan): PDF files sync too.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Authentication → Sign-in method → Google → "Web client ID": Android's account picker.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Local testing only: use the Firebase emulators on this host (e.g. 127.0.0.1).
NEXT_PUBLIC_FIREBASE_EMULATOR=

# ---- Stack AI ----
# Which engine answers: "openai" or "anthropic" (Claude). Keys are server only:
# never put them in a NEXT_PUBLIC_ variable.
AI_PROVIDER=
# Name shown in the app's "ask first" sheet, e.g. OpenAI or Claude.
NEXT_PUBLIC_AI_ENGINE=

# OpenAI (platform.openai.com → API keys)
OPENAI_API_KEY=
# Model for every feature (default gpt-5.5). Per feature: OPENAI_MODEL_SUMMARY,
# OPENAI_MODEL_TIDY, OPENAI_MODEL_ASK, OPENAI_MODEL_PDF (e.g. gpt-5.4-mini).
OPENAI_MODEL=

# Claude (platform.claude.com)
ANTHROPIC_API_KEY=
# Model for every feature (default claude-opus-5-5). Per feature: AI_MODEL_SUMMARY,
# AI_MODEL_TIDY, AI_MODEL_ASK, AI_MODEL_PDF (e.g. claude-sonnet-5-5 or claude-haiku-4-5).
# For the public launch, claude-haiku-4-5 keeps the cost per user low
# (see docs/StackForge_Stack_Plan.pdf, page 8).
AI_MODEL=

# Both engines:
# Requests per person per day (default 50; 20 is a safe start for a launch).
AI_DAILY_LIMIT=
# Where the Android app finds /api/ai: your deployed site, or the laptop's dev
# server from the emulator (http://10.0.2.2:3000). Leave empty to hide AI in the app.
# The Play build (build-aab.sh) only accepts an https address, e.g. https://stackforge.in
NEXT_PUBLIC_AI_URL=

# ---- Public pages ----
# Shown on /privacy and /delete-account (Google Play links to both).
NEXT_PUBLIC_SUPPORT_EMAIL=
